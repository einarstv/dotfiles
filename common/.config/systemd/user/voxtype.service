[Unit]
Description=Voxtype dictation daemon (auto language via Groq)
Documentation=https://voxtype.io
# No PartOf=graphical-session.target: it propagates stops whenever the
# session target restarts (e.g. omarchy restart shell), silently killing
# dictation. The user slice tears the daemon down at logout regardless.
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/voxtype/groq.env
ExecStart=/usr/bin/voxtype daemon
Restart=on-failure
RestartSec=5

[Install]
# Single tap-to-talk daemon, always available with the session. The bar mic
# icon's right click stops/starts it if you ever want dictation fully off.
WantedBy=graphical-session.target

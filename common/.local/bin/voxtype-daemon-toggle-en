#!/bin/bash
# Toggle the English dictation daemon (voxtype-english.service).

if systemctl --user is-active --quiet voxtype-english.service; then
  systemctl --user stop voxtype-english.service
  omarchy-notification-send -u low "Engelsk diktering: av" \
    "Ctrl + AltGr gjør ingenting før du slår på igjen (Shift + F9)"
else
  systemctl --user start voxtype-english.service
  omarchy-notification-send -u low "Engelsk diktering: på" \
    "Hold Ctrl + AltGr og snakk engelsk"
fi

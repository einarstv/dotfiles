#!/bin/bash
# Toggle the dictation engine between remote (Groq) and local whisper for
# both dictation daemons:
#   voxtype.service         = Norwegian (nb-whisper-small)
#   voxtype-english.service = English   (small.en)
#
# The API key lives in ~/.config/voxtype/groq.env (outside dotfiles),
# injected into both daemons via systemd drop-ins. This script only flips
# whisper.mode; stopped daemons pick up the new mode when next started.
#
# NOTE: `voxtype config set` replaces symlinks with real files, so after
# each flip we sync the content back into ~/dotfiles and restore the links.

set -euo pipefail

LIVE_DIR="$HOME/.config/voxtype"
REPO_DIR="$HOME/dotfiles/common/.config/voxtype"

repair_symlink() {
  local live="$LIVE_DIR/$1" repo="$REPO_DIR/$1"
  if [[ ! -L $live ]]; then
    cp "$live" "$repo"
    rm "$live"
    ln -s "../../dotfiles/common/.config/voxtype/$1" "$live"
  fi
}

current="$(voxtype config get whisper.mode)"
if [[ $current == remote ]]; then
  new=local
else
  new=remote
fi

voxtype config set whisper.mode "$new" >/dev/null
voxtype -c "$LIVE_DIR/english.toml" config set whisper.mode "$new" >/dev/null

repair_symlink config.toml
repair_symlink english.toml

# Restart only daemons that are running.
for svc in voxtype.service voxtype-english.service; do
  if systemctl --user is-active --quiet "$svc"; then
    systemctl --user restart "$svc"
  fi
done

if [[ $new == remote ]]; then
  omarchy-notification-send -u low "Diktering: Groq (sky)" \
    "F9/F10 transkriberer med whisper-large-v3-turbo via Groq"
else
  omarchy-notification-send -u low "Diktering: lokal" \
    "F10 = nb-whisper-small · F9 = small.en · Shift + F11 = tilbake til Groq"
fi

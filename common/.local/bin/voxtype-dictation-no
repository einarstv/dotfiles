#!/bin/bash
# Push-to-talk on the Norwegian dictation daemon (voxtype.service).
# Notifies once if the daemon is toggled off instead of recording.

CFG="$HOME/.config/voxtype/config.toml"

state="$(voxtype -c "$CFG" status 2>/dev/null)"

case "${1:-}" in
  start)
    if [[ $state == idle ]]; then
      voxtype -c "$CFG" record start
    elif [[ $state != recording ]]; then
      omarchy-notification-send -u low "Norsk diktering er av" \
        "Slå på med Shift + F10"
    fi
    ;;
  stop)
    # Silent: the release half only acts if a recording is in flight.
    if [[ $state == recording ]]; then
      voxtype -c "$CFG" record stop
    fi
    ;;
esac

#!/bin/bash
# Switch the dictation daemon between pinned Norwegian and English — one
# daemon, two complete configs. Copies config-no.toml / config-en.toml
# (both straight from the dotfiles, symlinked into ~/.config/voxtype/)
# over config.toml and restarts voxtype.service to apply (~0.4s). The
# active config.toml is generated state, so the tracked variants never
# mutate — nothing to drift. A pinned language code means Whisper's
# language ID can never land on Swedish (or Danish, Hebrew, ...), and the
# copy lands on the same inode the bar indicator's FileView watches.
#
# Usage: voxtype-lang           toggle no <-> en
#        voxtype-lang no|en     switch explicitly
#
# Bound to SHIFT + ALT + SPACE. If the daemon is stopped, only the config
# is switched; it comes up in the new language when started again.

set -euo pipefail

CFG_DIR="$HOME/.config/voxtype"

arg="${1:-toggle}"
current="$(voxtype config get whisper.language)"

case "$arg" in
  toggle) [[ $current == en ]] && target=no || target=en ;;
  no|en)  target="$arg" ;;
  *) echo "Usage: voxtype-lang [no|en]" >&2; exit 1 ;;
esac

# Never restart out from under a live recording.
state="$(voxtype status 2>/dev/null || true)"
case "$state" in
  recording|streaming|transcribing)
    omarchy-notification-send -u low "Dictation: can't switch language now" \
      "Stop the recording first — release the key and wait for the text"
    exit 0
    ;;
esac

cp "$CFG_DIR/config-$target.toml" "$CFG_DIR/config.toml"

systemctl --user is-active --quiet voxtype.service && systemctl --user restart voxtype.service

if [[ $target == no ]]; then
  label="Norwegian"
else
  label="English"
fi
omarchy-notification-send -u low "Dictation: $label" \
  "Hold Alt + Space and speak"

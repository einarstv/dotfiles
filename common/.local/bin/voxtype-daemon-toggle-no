#!/bin/bash
# Toggle the Norwegian dictation daemon (voxtype.service).

if systemctl --user is-active --quiet voxtype.service; then
  systemctl --user stop voxtype.service
  omarchy-notification-send -u low "Norsk diktering: av" \
    "Shift + AltGr gjør ingenting før du slår på igjen (Shift + F10)"
else
  systemctl --user start voxtype.service
  omarchy-notification-send -u low "Norsk diktering: på" \
    "Hold Shift + AltGr og snakk norsk"
fi
